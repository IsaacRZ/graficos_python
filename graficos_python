import matplotlib.pyplot as plt

# Datos de ejemplo
categorias = ['Producto A', 'Producto B', 'Producto C',
              'Producto D', 'Otros']
valores = [30, 25, 20, 15, 10]
colores = ['#2e0932', '#84094b', '#20a6d9', '#20dbd8', '#afedeb']

# Crear figura
fig, ax = plt.subplots(figsize=(10, 8))

# Crear gráfico circular
wedges, texts, autotexts = ax.pie(valores, labels=categorias,
                                    autopct='%1.1f%%',
                                    colors=colores,
                                    startangle=90,
                                    explode=(0.05, 0, 0, 0, 0),
                                    shadow=True)

