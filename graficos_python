import matplotlib.pyplot as plt
import numpy as np

# Datos de ejemplo
categorias = ['Comunicación', 'Trabajo en Equipo', 'Liderazgo',
              'Creatividad', 'Análisis', 'Técnicas']
estudiante_a = [8, 7, 6, 9, 7, 8]
estudiante_b = [7, 9, 8, 6, 8, 7]

# Número de variables
num_vars = len(categorias)

# Calcular ángulos para cada eje
angulos = np.linspace(0, 2 * np.pi, num_vars, endpoint=False).tolist()

# Cerrar el polígono (usando copias para no modificar las listas originales)
estudiante_a_plot = estudiante_a + estudiante_a[:1]
estudiante_b_plot = estudiante_b + estudiante_b[:1]
angulos_plot = angulos + angulos[:1]

# Crear figura
fig, ax = plt.subplots(figsize=(10, 10), subplot_kw=dict(projection='polar'))

# Plotear datos
ax.plot(angulos_plot, estudiante_a_plot, 'o-', linewidth=2,
        label='Estudiante A', color='#20a6d9')
ax.fill(angulos_plot, estudiante_a_plot, alpha=0.25, color='#20a6d9')

ax.plot(angulos_plot, estudiante_b_plot, 'o-', linewidth=2,
        label='Estudiante B', color='#84094b')
ax.fill(angulos_plot, estudiante_b_plot, alpha=0.25, color='#84094b')

# Personalización
ax.set_xticks(angulos)
ax.set_xticklabels(categorias, fontsize=11)
ax.set_ylim(0, 10)
ax.set_yticks([2, 4, 6, 8, 10])
ax.set_yticklabels(['2', '4', '6', '8', '10'], fontsize=9)
ax.set_title('Evaluación de Competencias',
             fontsize=14, fontweight='bold', pad=20)
ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1))
ax.grid(True)

plt.tight_layout()
plt.savefig('grafico_araña.png', dpi=300)
plt.show()
