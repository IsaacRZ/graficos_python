import matplotlib.pyplot as plt
import numpy as np

# Datos de ejemplo
categorias = ['Enero', 'Febrero', 'Marzo', 'Abril']
ingresos = [45, 52, 48, 58]
gastos = [38, 42, 40, 45]
utilidad = [7, 10, 8, 13]

# Configuración de posiciones
x = np.arange(len(categorias))
ancho = 0.25

# Crear figura
fig, ax = plt.subplots(figsize=(12, 6))

# Crear barras agrupadas
barras1 = ax.bar(x - ancho, ingresos, ancho, label='Ingresos',
                 color='#20a6d9', edgecolor='black')
barras2 = ax.bar(x, gastos, ancho, label='Gastos',
                 color='#84094b', edgecolor='black')
barras3 = ax.bar(x + ancho, utilidad, ancho, label='Utilidad',
                 color='#afedeb', edgecolor='black')

# Personalización
ax.set_xlabel('Meses', fontsize=12, fontweight='bold')
ax.set_ylabel('Monto (millones)', fontsize=12, fontweight='bold')
ax.set_title('Comparación Financiera Mensual',
             fontsize=14, fontweight='bold')
ax.set_xticks(x)
ax.set_xticklabels(categorias)
ax.legend()
ax.grid(axis='y', alpha=0.3)

# Agregar valores
for barras in [barras1, barras2, barras3]:
    for barra in barras:
        altura = barra.get_height()
        ax.text(barra.get_x() + barra.get_width()/2., altura,
                f'{int(altura)}', ha='center', va='bottom', fontsize=9)

plt.tight_layout()
plt.savefig('grafico_barras_comparativas.png', dpi=300)
plt.show()

