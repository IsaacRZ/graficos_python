import matplotlib.pyplot as plt
import numpy as np

# Datos de ejemplo
meses = np.arange(1, 13)
ventas_2023 = [120, 135, 145, 140, 155, 160, 158, 165, 170, 168, 175, 180]
ventas_2024 = [125, 140, 152, 148, 165, 172, 168, 178, 185, 182, 190, 195]

# Crear figura
plt.figure(figsize=(12, 6))

# Crear líneas
plt.plot(meses, ventas_2023, marker='o', linewidth=2,
         markersize=8, label='2023', color='#84094b')
plt.plot(meses, ventas_2024, marker='s', linewidth=2,
         markersize=8, label='2024', color='#20a6d9')

# Personalización
plt.xlabel('Meses', fontsize=12, fontweight='bold')
plt.ylabel('Ventas (miles)', fontsize=12, fontweight='bold')
plt.title('Evolución de Ventas Mensuales - Comparación Anual',
          fontsize=14, fontweight='bold')
plt.xticks(meses, ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun',
                   'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'])
plt.legend(fontsize=11)
plt.grid(True, alpha=0.3, linestyle='--')

# Agregar anotaciones
max_2024 = max(ventas_2024)
max_mes = ventas_2024.index(max_2024) + 1
plt.annotate(f'Máximo: {max_2024}',
             xy=(max_mes, max_2024),
             xytext=(max_mes-1, max_2024+5),
             arrowprops=dict(arrowstyle='->', color='red'),
             fontsize=10, fontweight='bold')

plt.tight_layout()
plt.savefig('grafico_lineal.png', dpi=300)
plt.show()

