import matplotlib.pyplot as plt
import numpy as np

# Datos de ejemplo
provincias = ['San José', 'Alajuela', 'Cartago', 'Heredia',
              'Guanacaste', 'Puntarenas', 'Limón']
poblacion = [1500, 950, 510, 440, 380, 480, 420]

# Ordenar de mayor a menor
datos_ordenados = sorted(zip(poblacion, provincias), reverse=False)
poblacion_ordenada = [p for p, _ in datos_ordenados]
provincias_ordenadas = [prov for _, prov in datos_ordenados]

# Crear figura
plt.figure(figsize=(12, 6))

# Colores personalizados
colores = ['#2e0932', '#84094b', '#20a6d9', '#20dbd8',
           '#afedeb', '#20a6d9', '#84094b']

# Crear gráfico de barras horizontales
barras = plt.barh(provincias_ordenadas, poblacion_ordenada, color=colores,
                  edgecolor='black', linewidth=1.5)

# Personalización
plt.xlabel('Población (miles)', fontsize=12, fontweight='bold')
plt.ylabel('Provincias', fontsize=12, fontweight='bold')
plt.title('Población por Provincia - Costa Rica',
          fontsize=14, fontweight='bold')
plt.grid(axis='x', alpha=0.3, linestyle='--')

# Agregar valores
for i, (barra, valor) in enumerate(zip(barras, poblacion_ordenada)):
    plt.text(valor + 20, barra.get_y() + barra.get_height()/2.,
             f'{int(valor)}',
             ha='left', va='center', fontweight='bold')

plt.tight_layout()
plt.savefig('grafico_barras_horizontales.png', dpi=300)
plt.show()

